{
  "name": "anime-clash",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @anime/web --filter @anime/api dev",
    "dev:web": "pnpm --filter @anime/web dev",
    "dev:api": "pnpm --filter @anime/api dev",
    "build": "pnpm --filter @anime/api build && pnpm --filter @anime/web build",
    "typecheck": "pnpm --filter @anime/api typecheck && pnpm --filter @anime/web typecheck",
    "lint": "pnpm --filter @anime/api lint && pnpm --filter @anime/web lint",
    "test": "node --import tsx --test tests/*.test.mjs && pnpm --filter @anime/api test",
    "test:integration": "node --test tests/postgres-schema.test.mjs tests/data-export.test.mjs && pnpm --filter @anime/api test:integration",
    "test:integration:local": "node scripts/database/local-integration.mjs",
    "test:import:local": "node scripts/database/verify-import.mjs",
    "db:generate": "pnpm --filter @anime/database exec drizzle-kit generate",
    "db:migrate": "node scripts/database/migrate.mjs",
    "db:seed": "node scripts/database/seed.mjs",
    "test:syntax": "node --test tests/source-syntax.test.mjs",
    "test:proxy": "node scripts/database/proxy-smoke.mjs",
    "test:e2e": "pnpm test:proxy"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "pg": "^8.23.1",
    "tsx": "^4.22.1",
    "typescript": "5.9.3"
  }
}
