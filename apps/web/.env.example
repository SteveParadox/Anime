# Anime Clash | Next.js web | apps/web/.env
# Copy to apps/web/.env (not the repository root .env).
# Windows CMD: copy apps\web\.env.example apps\web\.env
# Never commit real credentials or production .env files.

# Local Fastify API. Requests to /api/* are proxied from Next.js to here.
# REQUIRED whenever the web app makes API requests.
# On Vercel, set to the HTTPS Railway API origin (no trailing path).
API_UPSTREAM_ORIGIN=http://localhost:4000

# Optional locally; REQUIRED on Vercel (32+ characters).
# Must exactly match the server-only API_PROXY_SHARED_SECRET on Railway.
# Do NOT prefix it with NEXT_PUBLIC_ or expose it to browser code.
API_PROXY_SHARED_SECRET=

# Next.js automatically selects NODE_ENV for dev/build/start.
# No NEXT_PUBLIC_ variables are currently required by the app.
