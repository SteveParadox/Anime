{
  "name": "@anime/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "build": "tsup --config tsup.config.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:integration": "node --import tsx --test tests/integration.pg.test.mjs",
    "lint": "eslint src"
  },
  "dependencies": {
    "@anime/domain": "workspace:*",
    "@anime/database": "workspace:*",
    "fastify": "^5.0.0",
    "pg": "^8.0.0",
    "zod": "^3.25.76",
    "@anime/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "^8.0.0",
    "tsx": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "5.9.3"
  }
}
