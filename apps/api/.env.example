# Anime Clash | Fastify API | apps/api/.env
# Copy to apps/api/.env (not the repository root .env).
# Windows CMD: copy apps\api\.env.example apps\api\.env
# Never commit real credentials or production .env files.

# Core runtime (local development)
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL is required. The URL below matches docker-compose.yml when
# port 5432 is published to the Windows host (docker compose ps).
# 127.0.0.1 avoids localhost/IPv6 resolution issues on Windows.
# Replace with a separate Railway PostgreSQL DATABASE_URL for a Railway API.
DATABASE_URL=postgresql://anime:anime@127.0.0.1:5432/anime_clash
DB_POOL_MAX=10

# Browser -> Next.js -> Fastify proxy authentication.
# Optional for local development. REQUIRED in production: a random secret
# of at least 32 characters, identical in Railway API and Vercel web.
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Set a real secret only in private .env files or deployment secret settings.
API_PROXY_SHARED_SECRET=

# Google sign-in (optional; set client ID and secret together to enable).
# Register the exact redirect URI in Google Cloud OAuth credentials.
# In production, use https://YOUR_WEB_DOMAIN/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Email verification and password reset via Resend (optional).
# Both values are needed for sending real email. EMAIL_FROM must use
# a sender address/domain authorized in your Resend account.
RESEND_API_KEY=
EMAIL_FROM=

# Local development only: when true, verification/reset links appear in
# API logs. Never enable for production or shared development logs.
AUTH_DEV_EMAIL_LOG=false

# Optional: existing account ID granted application admin privileges.
# Leave empty until you know the exact intended account ID.
ANIME_CLASH_ADMIN_USER_ID=

# TEST ONLY (not required for the running app):
# Use a disposable, independently migrated database for integration tests.
# TEST_DATABASE_URL=postgresql://anime:anime@127.0.0.1:5432/anime_clash_test
